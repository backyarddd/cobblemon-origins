# Poke Mart purchase for the questbook shop pages (generated by packdev/quest_tools/gen/chapters/mart.py, core.r_buy).
# Called by an FTB Quests command reward as: execute as <buyer> run function cobblemon_origins:shop/buy
#   {item:"<id>",count:<n>,price:<total>,price_text:"<total with commas>",name:"<display name>"}
# cobbledollars remove clamps the balance at 0 instead of failing, so the balance is checked first; query returns it as
# the command result. A failed line does not stop a function, so the objective is (re)created here: if it were missing,
# the check below would error, remove would clamp at 0 and the item would be free. Re-adding an existing one fails quietly.
# Known limit: query returns the balance as a 32-bit int, so balances of 2^31 CD or more can read as too low (refusal only).
scoreboard objectives add cobblemon_origins.shop dummy
# Macro line on purpose: Arclight checks mod command permissions through Bukkit while parsing, and Bukkit is not up at
# the first datapack load, so a plain line with a mod command fails the whole function. Macro lines parse when called.
# A macro line needs a variable; #shop_unset_<count> never has a score, so the unless check always passes.
$execute unless score #shop_unset_$(count) cobblemon_origins.shop matches 0 store result score @s cobblemon_origins.shop run cobbledollars query @s
$execute unless score @s cobblemon_origins.shop matches $(price).. run return run tellraw @s ["",{"text":"Not enough CobbleDollars: ","color":"red"},{"text":"$(name)","color":"yellow"},{"text":" costs $(price_text).","color":"red"}]
$cobbledollars remove @s $(price)
$give @s $(item) $(count)
$tellraw @s ["",{"text":"Bought ","color":"green"},{"text":"$(name)","color":"yellow"},{"text":" for $(price_text) CobbleDollars.","color":"green"}]
